{
  "name": "smichaelsen/caldera-php",
  "description": "Caldera Records Parser",
  "type": "library",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "Sebastian Michaelsen",
      "email": "sebastian@michaelsen.io"
    }
  ],
  "autoload": {
    "psr-4": {
      "Smichaelsen\\Caldera\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Smichaelsen\\Caldera\\Test\\": "tests/"
    }
  },
  "require": {
    "php": "^7.3 || ^8.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^2.12.1",
    "phpunit/phpunit": "^9 || ^10 || ^11",
    "phpstan/phpstan": "^2.1"
  },
  "scripts": {
    "phpstan": "phpstan analyse",
    "test": "phpunit"
  }
}
